# =============================================================================
# Tauditor — production / Docker environment
# Copy to .env on the server and fill real values. Never commit .env.
# =============================================================================

# --- Django core ---
# REQUIRED: the app refuses to start with DEBUG=False and an empty SECRET_KEY.
# IMPORTANT: do NOT put "$" characters in SECRET_KEY.
# Docker Compose treats $name as a variable and breaks the value.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64).replace('$',''))"
SECRET_KEY=change-me-to-a-long-random-string-without-dollar-signs
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,YOUR_SERVER_IP,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com,http://localhost,http://127.0.0.1,http://localhost:8080
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com,http://localhost,http://127.0.0.1,http://localhost:8080

# Public HTTP port published by nginx (use 8080 for local Windows tests)
HTTP_PORT=80

# --- Grafana (single monitoring UI). Prometheus is internal — do not expose it. ---
# Open http://127.0.0.1:3030  (not on the public site port)
# Remote VPS: ssh -L 3030:127.0.0.1:3030 user@YOUR_SERVER
# Bind 0.0.0.0 only if you also firewall / VPN this port.
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3030
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-password
GRAFANA_ROOT_URL=http://127.0.0.1:3030

# Set True ONLY after TLS certificates are live in nginx.
# True enables secure-only cookies, HTTPS redirect and HSTS —
# turning it on while still serving plain HTTP breaks admin login.
USE_HTTPS=False

# Swagger UI + raw OpenAPI schema at /api/docs/ and /api/schema/.
# Keep False in production; the API surface is internal.
ENABLE_API_DOCS=False

# --- Database (Postgres container) ---
# Compose interpolates DB_* into BOTH postgres and Django.
# If you change DB_PASSWORD after the first start, recreate the volume:
#   docker compose down -v && docker compose up -d --build
# Windows tip: a host/user env var named DB_PASSWORD overrides this file for
# Compose interpolation — remove it if Postgres auth fails after rebuild.
DB_ENGINE=postgres
DB_NAME=tauditor
DB_USER=tauditor
# REQUIRED: set a strong password before going live (no quotes, no $)
DB_PASSWORD=change-me-strong-db-password
DB_HOST=db
DB_PORT=5432

# --- Redis (OTP + cache) ---
REDIS_URL=redis://redis:6379/1
USE_REDIS_CACHE=True

# --- SMS.ir OTP ---
SMS_IR_API_URL=https://api.sms.ir/v1/send/verify
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=435807
OTP_DEBUG_MODE=False

# --- Shahkar (optional) ---
SHAHKAR_API_URL=https://s.api.ir/api/sw1/ShahkarLite
SHAHKAR_API_TOKEN=

# --- Gunicorn sizing (~1000 users on a 2–4 vCPU VPS) ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# --- Frontend (build-time; same-origin via nginx) ---
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Public site URL for SEO canonical / Open Graph / sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://tauditor.com
